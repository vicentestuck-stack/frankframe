{
  "expo": {
    "name": "Frankframe",
    "slug": "frankframe",
    "version": "1.0.0",
    "scheme": "frankframe",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0D",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to take photos and videos",
          "microphonePermission": "Allow $(PRODUCT_NAME) to use your microphone to record video sound",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to save photos and videos to your library",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos and videos to your library",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing"
    ]
  }
}
