# Copy to .env.local (gitignored). EXPO_PUBLIC_* vars are embedded in the
# client bundle, so only put values here that are safe for anyone who
# inspects the shipped app to see — the anon key, never the service role
# key (that one lives only in camera-clone-backend/.env.local).

# Same Supabase project as camera-clone-backend's SUPABASE_URL/SUPABASE_ANON_KEY.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# camera-clone-backend's deployed URL (or http://localhost:3000 in dev).
# Without this set, the app runs entirely on its local data layer — see
# src/lib/api.ts.
EXPO_PUBLIC_API_URL=
